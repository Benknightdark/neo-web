{
  "name": "introduction",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/portal/introduction/src",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "deploy/portal/introduction"
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "introduction:build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["vitest run --passWithNoTests"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["vue-tsc -p apps/portal/introduction/tsconfig.json --noEmit"]
      }
    }
  }
}
