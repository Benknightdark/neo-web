{
  "name": "home",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/portal/home/src",
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/{options.outDir}", "{projectRoot}/dist", "{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../../deploy/portal/home"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["vitest run --passWithNoTests"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["vue-tsc -p apps/portal/home/tsconfig.json --noEmit"]
      }
    }
  }
}
