@{
    ViewData["Title"] = "Home Page";
    var versionedJs = Url.Content("~/js/home/home.js") + "?v=" + Guid.NewGuid(); // 自訂版本參數
}
@section Styles {
    <link rel="stylesheet" href="~/css/home/home.css" asp-append-version="true" />
}
@section Scripts {
<script type="module">
    import React from "https://esm.sh/react@19.1.0?min";
    import ReactDOM from "https://esm.sh/react-dom@19.1.0/client?min";
    window.React = React;
    window.ReactDOM = ReactDOM;
    import("@versionedJs").catch(console.error);
</script>
}
<div id="root"></div>
